{
  "$comment": "Top-level contract for conformance.json. validate-conformance.cjs interprets this schema with the same interpreter as report-schema.json and adds checklist and identifier checks. A conformance record states whether a control is visible in source. It is not a vulnerability record: it has no verdict, no severity and no reproduction.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "description": "The control is implemented and the source shows where.",
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^([A-Z]{2}-[0-9]{2}|X-[A-Z0-9][A-Z0-9-]{0,23})$"
          },
          "status": {
            "type": "string",
            "const": "met"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "required": ["file", "line", "description"],
              "additionalProperties": false
            }
          },
          "standards": {
            "type": "object",
            "properties": {
              "cwe": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CWE-[1-9][0-9]{0,4}$"
                }
              },
              "owasp_top10": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^A(0[1-9]|10):(2021|2025)$"
                }
              },
              "owasp_asvs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^v5\\.0\\.0-[1-9][0-9]?\\.[1-9][0-9]?(\\.[1-9][0-9]?)?$"
                }
              },
              "iso27001": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^A\\.[5-8]\\.[1-9][0-9]?$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["control_id", "status", "title", "summary", "evidence"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "description": "The control is absent or incomplete, and the source shows it. A gap is hardening work, not a demonstrated vulnerability.",
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^([A-Z]{2}-[0-9]{2}|X-[A-Z0-9][A-Z0-9-]{0,23})$"
          },
