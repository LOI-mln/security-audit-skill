                  "visibleContent": true
                }
              },
              "required": ["file", "line", "description"],
              "additionalProperties": false
            }
          },
          "remediation": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "code_changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fixed_code": {
                      "type": "string"
                    }
                  },
                  "required": ["file_name", "fixed_code"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["strategy"],
            "additionalProperties": false
          },
          "priority": {
            "type": "object",
            "description": "Order of work for hardening. Not a severity: no boundary failure was demonstrated.",
            "properties": {
              "level": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": ["level", "reason"],
            "additionalProperties": false
          },
          "related_fingerprints": {
            "type": "array",
            "description": "Fingerprints of findings.json records with the same root cause, so the fix is planned once.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
            }
          },
          "standards": {
            "type": "object",
            "properties": {
              "cwe": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CWE-[1-9][0-9]{0,4}$"
                }
              },
              "owasp_top10": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^A(0[1-9]|10):(2021|2025)$"
                }
              },
              "owasp_asvs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^v5\\.0\\.0-[1-9][0-9]?\\.[1-9][0-9]?(\\.[1-9][0-9]?)?$"
                }
              },
              "iso27001": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^A\\.[5-8]\\.[1-9][0-9]?$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["control_id", "status", "title", "summary", "evidence", "remediation", "priority"],
        "additionalProperties": false
      },
